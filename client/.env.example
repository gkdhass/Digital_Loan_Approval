# API Configuration
VITE_API_URL=https://your-backend.vercel.app/api

# EmailJS Configuration
# Service ID for all EmailJS emails
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Template IDs
# IMPORTANT: DO NOT enable Auto-Reply on any template
# Both emails are triggered by explicit emailjs.send() calls in application code
# - Submission template: template_1grm5uf - sent after application created AND documents uploaded
# - Decision template: template_jqn7gcp - sent from admin approve/reject actions
VITE_EMAILJS_TEMPLATE_SUBMISSION=template_1grm5uf
VITE_EMAILJS_TEMPLATE_DECISION=template_jqn7gcp
